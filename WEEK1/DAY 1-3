# --- 5.1 append/extand/slicing ---
fruits = ["apple" , "banana"]

# append
fruits.append("cherry") # add an element into the list
print(fruits)

# extend
other = ["orange","grape"] 
fruits.extend(other) # add another list into the list
print(fruits)

# insert
fruits.insert(1,"mango") # add an element into specific index (in this case it will insert to the second one)
print(fruits)

