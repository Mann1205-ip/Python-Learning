# --- if/else ---
import random
num = 6
chance = 3

while chance > 0:
    guess = int(input("Your guess: "))
    if guess == num:
        print("You win")
        break

    chance -= 1
    if chance == 0:
        print("All chance is used! You lose")
        print(f"The correct answer is {num}")
        break

    if guess > num:
        print("Too high! Try again")
    else:
        print("Too low! Try again")

# --- while ---
i = 1
while i <= 9:
    j = 1
    while j <= i:
        print(f"{j} * {i} = {j * i}\t", end=" ")
        j += 1

    i += 1
    print()

# --- for ---
for i in range(1,10):
    for j in range(1,i + 1):
            print(f"{j} * {i} = {j * i}", end="\t")

    print()

